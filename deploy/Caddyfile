# deploy/Caddyfile - feature 017: TLS in front of the app (which stays on localhost).
# Fill YOUR_DOMAIN, then: sudo caddy run --config deploy/Caddyfile
#
# ACCESS DECISION (2026-07-12, docs/DEPLOYMENT_QUESTIONS.md answers): NO login for the
# single-designer testing phase. The mitigation for the open-spend risk is the URL itself:
# use an UNGUESSABLE subdomain (e.g. xcela-k3v9q2.yourdomain.tld), share it privately, and
# never link it anywhere public. To add a shared password later, uncomment the basic_auth
# block and fill the hash from `caddy hash-password` (zero app-code impact).

YOUR_DOMAIN {
    # basic_auth {
    #     xcela HASHED_PASSWORD
    # }
    reverse_proxy 127.0.0.1:8765
    # uploads (style reference + product shots + VI PDFs) are capped app-side
    # (XCELA_MAX_UPLOAD_MB, default 32MB)
    request_body {
        max_size 64MB
    }
}
