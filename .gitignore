# ── Python ──
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.ipynb_checkpoints/

# ── Generated outputs (regenerable, large: ~141M) ──
output/

# ── Brand assets: LICENSED fonts + client IP + VI PDFs ──
# Confidential AND large (188M fonts, 20M assets). NEVER commit. Stay local.
# A fresh clone will not have these; re-add brand assets locally to run.
brands/

# ── Large / binary belt-and-suspenders ──
*.psd
*.ai
*.zip
*.7z

# ── Secrets ──
.env
*.env
.env.*
!.env.example
*token*.json
*credential*
# 021: auth whitelist (scrypt hashes) + live session tokens are RUNTIME state
users.json
sessions.json

# ── OS cruft ──
.DS_Store
Thumbs.db

# 019: answer keys are RUNTIME state (a deployment's own brand database)
answer_keys/*.json
!answer_keys/.gitkeep
