# xcela configuration — copy to <repo>/.env and fill in, OR set these as real environment
# variables (systemd/Docker/shell). Real environment variables ALWAYS win over this file.
# Loader + precedence: harness/runtime_env.py (env > <repo>/.env > ~/.hermes/.env legacy).

# --- REQUIRED: model API keys (yours) ---------------------------------------------------
# OpenAI: gpt-image-2 (image generation, the paid step, ~$0.08/image)
OPENAI_API_KEY=
# Anthropic: claude (prompt authoring + reference analysis under the DEFAULT model config;
# NOT needed when XCELA_TEXT_MODELS below names only OpenAI models, e.g. gpt-5.5)
ANTHROPIC_API_KEY=

# --- OPTIONAL: custom API endpoints (yaoyj merge 2026-07-14; both pinned SDKs read these
# natively, so they apply to every call incl. image generation) ---------------------------
# OpenAI-compatible base URL (relays/proxies; blank = api.openai.com)
#OPENAI_BASE_URL=
# Anthropic base URL (blank = api.anthropic.com)
#ANTHROPIC_BASE_URL=

# --- OPTIONAL: server knobs (defaults shown; all read by frontend/server.py) -------------
# Bind address; keep 127.0.0.1 and put a TLS proxy in front (deploy/Caddyfile)
#XCELA_BIND=127.0.0.1
# Port (a CLI argument to server.py wins over this)
#XCELA_PORT=8765
# Reject uploads larger than this (MB) before reading them
#XCELA_MAX_UPLOAD_MB=32
# Kill a generation/export worker after this many seconds (frees the one-at-a-time lock)
#XCELA_WORKER_TIMEOUT_S=1800

# --- OPTIONAL: model choice (feature 020; the provider is inferred from the name:
# claude-* -> Anthropic, anything else -> OpenAI chat) --------------------------------------
# Text/vision fallback chain, comma-separated (planning, analysis, scoring)
#XCELA_TEXT_MODELS=claude-opus-4-5,claude-sonnet-4-6
# e.g. an all-OpenAI deployment (Kevin's): XCELA_TEXT_MODELS=gpt-5.5 (+ OPENAI_BASE_URL above)
# Image generation model
#XCELA_IMAGE_MODEL=gpt-image-2

# --- OPTIONAL: asset locations ------------------------------------------------------------
# Where brand assets (logos, uploaded via the /onboard wizard) live; default <repo>/brands
#XCELA_BRANDS_DIR=
# Where answer keys (the brand database, written by onboarding) live; default <repo>/answer_keys
#XCELA_ANSWER_KEYS_DIR=

# --- OPTIONAL: login + per-user isolation (feature 021) ------------------------------------
# Auth activates ONLY when this file exists (create users with:
#   .venv/bin/python frontend/auth.py add <user> [--super]
# ); no file = open access, exactly the pre-021 behavior. sessions.json lives beside it.
# Default <repo>/users.json
#XCELA_USERS_FILE=
